{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/admin/ddv3-preview/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/ddv3-preview/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
