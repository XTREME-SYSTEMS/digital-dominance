{
  "version": 2,
  "rewrites": [
    { "source": "/templates", "destination": "/index.html" },
    { "source": "/templates/:path*", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/prompt-chain?job=chain-sweep", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/prompt-chain?job=nightly-audit", "schedule": "0 4 * * *" }
  ]
}