{
  "name": "GeneratedPage",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "description": "URL slug (kebab-case, no leading slash)"
    },
    "keyword": {
      "type": "string",
      "description": "Primary keyword/topic the page targets"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "meta_description": {
      "type": "string",
      "maxLength": 500
    },
    "h1": {
      "type": "string"
    },
    "intro": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "h2": {
            "type": "string"
          },
          "body": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "list": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "a": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "preview",
        "validated",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "content": {
      "type": "string",
      "maxLength": 30000,
      "description": "Rendered draft body/content when used by generators"
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "string",
      "maxLength": 500
    },
    "canonical_path": {
      "type": "string",
      "description": "Canonical route candidate for this page"
    },
    "source_opportunity_id": {
      "type": "string"
    },
    "source_evidence_state": {
      "type": "string",
      "default": "unknown"
    },
    "validation_work_packet_id": {
      "type": "string"
    },
    "unique_value_summary": {
      "type": "string",
      "maxLength": 3000
    },
    "robots_directive": {
      "type": "string",
      "default": "noindex, follow"
    },
    "index_eligible": {
      "type": "boolean",
      "default": false
    },
    "sitemap_eligible": {
      "type": "boolean",
      "default": false
    },
    "release_authorized": {
      "type": "boolean",
      "default": false
    },
    "serviceability_verified": {
      "type": "boolean",
      "default": false
    },
    "local_value_score": {
      "type": "number",
      "default": 0
    },
    "eligibility_state": {
      "type": "string",
      "enum": [
        "research_only",
        "candidate",
        "blocked",
        "eligible"
      ],
      "default": "research_only"
    },
    "eligibility_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "eligibility_evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "slug",
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
