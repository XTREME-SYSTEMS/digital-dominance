{
  "name": "Lead",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "lead_source": {
      "type": "string",
      "default": "website"
    },
    "lead_type": {
      "type": "string",
      "enum": [
        "homeowner",
        "contractor",
        "business",
        "b2b",
        "social"
      ],
      "description": "Category of lead for routing and outreach"
    },
    "referrer": {
      "type": "string"
    },
    "landing_page": {
      "type": "string"
    },
    "utm_source": {
      "type": "string"
    },
    "utm_medium": {
      "type": "string"
    },
    "utm_campaign": {
      "type": "string"
    },
    "utm_term": {
      "type": "string"
    },
    "utm_content": {
      "type": "string"
    },
    "session_id": {
      "type": "string",
      "description": "Stable browser-session identifier used to join FunnelEvent records to this lead"
    },
    "site_id": {
      "type": "string",
      "description": "Hostname/site that captured the lead"
    },
    "build_sha": {
      "type": "string",
      "description": "Source/build SHA when available"
    },
    "deployment_id": {
      "type": "string",
      "description": "Deployment identifier when available"
    },
    "first_referrer": {
      "type": "string"
    },
    "first_landing_page": {
      "type": "string"
    },
    "first_utm_source": {
      "type": "string"
    },
    "first_utm_medium": {
      "type": "string"
    },
    "first_utm_campaign": {
      "type": "string"
    },
    "first_utm_term": {
      "type": "string"
    },
    "first_utm_content": {
      "type": "string"
    },
    "last_referrer": {
      "type": "string"
    },
    "last_landing_page": {
      "type": "string"
    },
    "last_utm_source": {
      "type": "string"
    },
    "last_utm_medium": {
      "type": "string"
    },
    "last_utm_campaign": {
      "type": "string"
    },
    "last_utm_term": {
      "type": "string"
    },
    "last_utm_content": {
      "type": "string"
    },
    "conversion_page": {
      "type": "string"
    },
    "attribution_captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "device": {
      "type": "string"
    },
    "garage_size": {
      "type": "string"
    },
    "custom_length": {
      "type": "number"
    },
    "custom_width": {
      "type": "number"
    },
    "square_footage": {
      "type": "number"
    },
    "sqft_source": {
      "type": "string",
      "description": "Which source provided the garage sqft"
    },
    "sqft_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "floor_condition": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "desired_system": {
      "type": "string"
    },
    "flake_color": {
      "type": "string"
    },
    "flake_color_name": {
      "type": "string"
    },
    "flake_color_hex": {
      "type": "string"
    },
    "timeline": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concept_image": {
      "type": "string"
    },
    "estimate_mid": {
      "type": "number"
    },
    "estimate_low": {
      "type": "number"
    },
    "estimate_high": {
      "type": "number"
    },
    "package_options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tier": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "low": {
            "type": "number"
          },
          "high": {
            "type": "number"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "lead_score": {
      "type": "number",
      "default": 0
    },
    "assigned_salesperson": {
      "type": "string"
    },
    "assigned_agent_id": {
      "type": "string"
    },
    "appointment_status": {
      "type": "string",
      "default": "none"
    },
    "enrichment": {
      "type": "string",
      "maxLength": 3000
    },
    "status": {
      "type": "string",
      "enum": [
        "NEW ESTIMATE",
        "CONTACT ATTEMPTED",
        "CONSULTATION BOOKED",
        "CONSULTATION COMPLETED",
        "IN-HOME ESTIMATE BOOKED",
        "IN-HOME ESTIMATE COMPLETED",
        "PROPOSAL SENT",
        "WON",
        "LOST",
        "NURTURE"
      ],
      "default": "NEW ESTIMATE"
    },
    "won_value": {
      "type": "number"
    },
    "hubspot_contact_id": {
      "type": "string"
    },
    "hubspot_deal_id": {
      "type": "string"
    },
    "closed_won_at": {
      "type": "string",
      "format": "date-time"
    },
    "actual_revenue": {
      "type": "number",
      "description": "Verified realized revenue. Never substitute estimate_mid for this field."
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "revenue_source": {
      "type": "string",
      "enum": [
        "hubspot",
        "manual",
        "stripe",
        "other"
      ]
    },
    "revenue_evidence_class": {
      "type": "string",
      "enum": [
        "closed_won_booked",
        "collected",
        "refunded",
        "unknown"
      ],
      "default": "unknown",
      "description": "Distinguishes booked CRM value from actually collected revenue"
    },
    "revenue_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "test_data_classification": {
      "type": "string",
      "enum": [
        "test_confirmed",
        "test_likely",
        "real_confirmed",
        "unknown"
      ],
      "default": "unknown",
      "description": "Whether this lead is test data or real business data — excludes test records from business KPIs"
    },
    "actual_fulfillment_cost": {
      "type": "number",
      "description": "Verified actual fulfillment cost when available. Never inferred from estimates."
    },
    "actual_gross_profit": {
      "type": "number",
      "description": "Verified gross profit derived from collected revenue and verified fulfillment cost."
    },
    "margin_evidence_class": {
      "type": "string",
      "enum": [
        "verified",
        "unknown"
      ],
      "default": "unknown"
    },
    "margin_synced_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "first_name",
    "email",
    "phone"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
