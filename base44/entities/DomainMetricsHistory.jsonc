{
  "name": "DomainMetricsHistory",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "User ID who owns this snapshot"
    },
    "domain_id": {
      "type": "string",
      "description": "Reference to DomainRegistry record"
    },
    "domain": {
      "type": "string",
      "description": "Domain name"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date",
      "description": "Date of this daily snapshot"
    },
    "gsc_clicks": {
      "type": "number",
      "default": 0
    },
    "gsc_impressions": {
      "type": "number",
      "default": 0
    },
    "ga_sessions": {
      "type": "number",
      "default": 0
    },
    "ga_users": {
      "type": "number",
      "default": 0
    },
    "health_score": {
      "type": "number",
      "default": 0
    },
    "competitor_count": {
      "type": "number",
      "default": 0
    },
    "sitemap_url_count": {
      "type": "number",
      "default": 0
    },
    "issues_count": {
      "type": "number",
      "default": 0
    },
    "indexed_pages": {
      "type": "number",
      "default": 0,
      "description": "Count of pages confirmed indexed via URL inspection"
    },
    "not_indexed_pages": {
      "type": "number",
      "default": 0,
      "description": "Count of pages not indexed"
    }
  },
  "required": [
    "domain_id",
    "domain",
    "snapshot_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}