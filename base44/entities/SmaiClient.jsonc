{
  "name": "SmaiClient",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Stable deterministic client ID"
    },
    "user_id": {
      "type": "string",
      "description": "Associated Base44 user ID (after deposit + signup)"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "business_url": {
      "type": "string",
      "format": "uri"
    },
    "industry": {
      "type": "string"
    },
    "deposit_paid": {
      "type": "boolean",
      "default": false
    },
    "deposit_amount_cents": {
      "type": "number",
      "default": 0
    },
    "deposit_paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "checkout_session_id": {
      "type": "string"
    },
    "temp_credentials_issued": {
      "type": "boolean",
      "default": false
    },
    "password_changed": {
      "type": "boolean",
      "default": false
    },
    "onboarding_step": {
      "type": "string",
      "enum": [
        "deposit",
        "password_change",
        "eden_welcome",
        "esign",
        "questionnaire",
        "vision",
        "skip_trace",
        "logo_generation",
        "strategy_generation",
        "complete"
      ],
      "default": "deposit"
    },
    "skip_trace_completed": {
      "type": "boolean",
      "default": false
    },
    "skip_trace_summary": {
      "type": "string",
      "maxLength": 10000
    },
    "social_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "followers": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "public_info_summary": {
      "type": "string",
      "maxLength": 10000
    },
    "identified_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "identified_problems": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "logo_concepts_generated": {
      "type": "boolean",
      "default": false
    },
    "logo_concept_count": {
      "type": "number",
      "default": 0
    },
    "strategy_count": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "prospective",
        "deposited",
        "onboarding",
        "active",
        "archived"
      ],
      "default": "prospective"
    }
  },
  "required": [
    "client_id",
    "full_name",
    "email",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}