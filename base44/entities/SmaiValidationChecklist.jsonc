{
  "name": "SmaiValidationChecklist",
  "type": "object",
  "properties": {
    "checklist_id": {
      "type": "string"
    },
    "sandbox_job_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "frontend",
              "backend",
              "buttons",
              "user_flow",
              "visual_parity",
              "operational_parity",
              "pack_compliance",
              "performance",
              "security",
              "seo"
            ]
          },
          "description": {
            "type": "string",
            "description": "What must be true for this item to pass"
          },
          "test_method": {
            "type": "string",
            "enum": [
              "screenshot_diff",
              "button_click_test",
              "form_submission_test",
              "route_test",
              "api_response_test",
              "visual_comparison",
              "pack_match",
              "lighthouse_audit",
              "security_scan",
              "seo_audit"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "testing",
              "passed",
              "failed",
              "warning"
            ],
            "default": "pending"
          },
          "result_detail": {
            "type": "string"
          },
          "tested_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "total_items": {
      "type": "number",
      "default": 0
    },
    "passed_items": {
      "type": "number",
      "default": 0
    },
    "failed_items": {
      "type": "number",
      "default": 0
    },
    "overall_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 0
    },
    "is_100_percent": {
      "type": "boolean",
      "default": false
    },
    "pack_reference": {
      "type": "object",
      "properties": {
        "web_pack_url": {
          "type": "string"
        },
        "logo_pack_url": {
          "type": "string"
        },
        "brand_pack_url": {
          "type": "string"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "checklist_id",
    "sandbox_job_id",
    "items",
    "total_items"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}