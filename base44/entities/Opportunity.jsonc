{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Opportunity title"
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "problem": {
      "type": "string",
      "maxLength": 5000,
      "description": "The problem people are complaining about"
    },
    "buyer": {
      "type": "string",
      "description": "Who would pay for the solution"
    },
    "app_idea": {
      "type": "string",
      "maxLength": 5000,
      "description": "What app/tool/SaaS to build"
    },
    "monetization": {
      "type": "string",
      "maxLength": 2000,
      "description": "How to make money from this"
    },
    "evidence": {
      "type": "string",
      "maxLength": 3000
    },
    "source_url": {
      "type": "string"
    },
    "scanner_source": {
      "type": "string",
      "description": "Which scanner found this (scan_google_trends, etc)"
    },
    "scanner_label": {
      "type": "string",
      "description": "Human-readable scanner name"
    },
    "score": {
      "type": "number",
      "default": 0,
      "description": "Legacy scanner/model hypothesis score 0-10. Not validated demand; use decision_score for V3 prioritization."
    },
    "status": {
      "type": "string",
      "enum": [
        "saved",
        "reviewing",
        "validated",
        "building",
        "launched",
        "archived"
      ],
      "default": "saved"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "notes": {
      "type": "string",
      "maxLength": 5000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "service": {
      "type": "string",
      "description": "Service or product category this opportunity targets"
    },
    "intent": {
      "type": "string",
      "enum": [
        "transactional",
        "commercial",
        "informational",
        "navigational",
        "mixed",
        "unknown"
      ],
      "default": "unknown"
    },
    "geography": {
      "type": "string",
      "description": "Geography this opportunity applies to"
    },
    "buyer_archetype": {
      "type": "string",
      "description": "Normalized buyer archetype"
    },
    "hypothesis_score": {
      "type": "number",
      "default": 0,
      "description": "0-10 scanner/model hypothesis score. Never treated as validated demand."
    },
    "decision_score": {
      "type": "number",
      "default": 0,
      "description": "0-100 DDV3 evidence-adjusted decision score"
    },
    "evidence_state": {
      "type": "string",
      "enum": [
        "hypothesis",
        "partially_verified",
        "verified",
        "blocked",
        "expired"
      ],
      "default": "hypothesis"
    },
    "evidence_count": {
      "type": "number",
      "default": 0
    },
    "evidence_coverage_pct": {
      "type": "number",
      "default": 0,
      "description": "Percent of weighted V3 score dimensions supported by active scored evidence"
    },
    "evidence_quality_score": {
      "type": "number",
      "default": 0,
      "description": "0-100 aggregate quality of supporting evidence"
    },
    "score_version": {
      "type": "string"
    },
    "score_breakdown": {
      "type": "string",
      "maxLength": 5000,
      "description": "Serialized deterministic score breakdown by dimension"
    },
    "automation_eligibility": {
      "type": "string",
      "enum": [
        "research_only",
        "preview_candidate",
        "release_candidate",
        "blocked"
      ],
      "default": "research_only",
      "description": "Eligibility only. Never authorizes protected production actions."
    },
    "last_scored_at": {
      "type": "string",
      "format": "date-time"
    },
    "build_plan_id": {
      "type": "string",
      "description": "Latest DDV3 WebsiteBuildPlan ID"
    },
    "build_plan_status": {
      "type": "string",
      "description": "Latest preview build-plan status"
    },
    "build_plan_policy_version": {
      "type": "string"
    },
    "preview_artifact_id": {
      "type": "string",
      "description": "Latest private WebsitePreviewArtifact ID"
    },
    "preview_status": {
      "type": "string",
      "description": "Latest private preview status"
    }
  },
  "required": [
    "title",
    "scanner_source"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": null,
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
