{
  "name": "HighLeverageCapability",
  "type": "object",
  "properties": {
    "capability_id": {
      "type": "number",
      "description": "1-60 from the workbook"
    },
    "domain": {
      "type": "string",
      "enum": [
        "Intelligence",
        "Content",
        "Technical",
        "Authority",
        "Conversion",
        "Local",
        "Operations",
        "Governance",
        "Measurement",
        "Autonomy"
      ]
    },
    "capability_name": {
      "type": "string"
    },
    "exact_implementation": {
      "type": "string",
      "maxLength": 2000
    },
    "priority": {
      "type": "string",
      "enum": [
        "Critical",
        "High",
        "Medium",
        "Low"
      ],
      "default": "Medium"
    },
    "verified_live": {
      "type": "string",
      "enum": [
        "UNKNOWN",
        "VERIFIED",
        "MISSING",
        "PARTIAL"
      ],
      "default": "UNKNOWN"
    },
    "implementation_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "implemented",
        "verified",
        "deferred"
      ],
      "default": "not_started"
    },
    "evidence_ref": {
      "type": "string",
      "description": "File path or URL proving implementation"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "capability_id",
    "domain",
    "capability_name",
    "priority"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}