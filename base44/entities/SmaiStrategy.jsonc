{
  "name": "SmaiStrategy",
  "type": "object",
  "properties": {
    "strategy_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "strategy_number": {
      "type": "number",
      "description": "1-N"
    },
    "category": {
      "type": "string",
      "enum": [
        "business_strategy",
        "system_architecture",
        "website_design",
        "marketing_funnel",
        "social_media",
        "seo_dominance",
        "brand_positioning",
        "revenue_optimization"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "rationale": {
      "type": "string",
      "maxLength": 3000,
      "description": "Why this strategy fits the client based on skip trace + questionnaire"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "estimated_impact": {
      "type": "string"
    },
    "implementation_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "client_approved": {
      "type": "boolean",
      "default": false
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "batch_id": {
      "type": "string"
    }
  },
  "required": [
    "strategy_id",
    "client_id",
    "strategy_number",
    "category",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}