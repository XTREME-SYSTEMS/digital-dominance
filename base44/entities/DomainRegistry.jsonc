{
  "name": "DomainRegistry",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "User ID who owns this domain"
    },
    "domain": {
      "type": "string",
      "description": "Domain name (e.g. benearme.com)"
    },
    "canonical_url": {
      "type": "string",
      "description": "Full canonical URL (https://...)"
    },
    "status": {
      "type": "string",
      "enum": [
        "onboarding",
        "active",
        "monitoring",
        "failed"
      ],
      "default": "onboarding"
    },
    "search_console_property": {
      "type": "string",
      "description": "GSC property URL (sc-domain:...)"
    },
    "search_console_verified": {
      "type": "boolean",
      "default": false
    },
    "ga4_property_id": {
      "type": "string",
      "description": "GA4 property resource name"
    },
    "sitemap_url": {
      "type": "string",
      "description": "Sitemap URL if found"
    },
    "sitemap_submitted": {
      "type": "boolean",
      "default": false
    },
    "sitemap_url_count": {
      "type": "number",
      "default": 0
    },
    "robots_checked": {
      "type": "boolean",
      "default": false
    },
    "index_status": {
      "type": "string",
      "description": "JSON summary of index coverage"
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "target_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "gsc_clicks": {
      "type": "number",
      "default": 0
    },
    "gsc_impressions": {
      "type": "number",
      "default": 0
    },
    "gsc_top_queries": {
      "type": "string",
      "description": "JSON of top search queries with clicks/impressions"
    },
    "ga_sessions": {
      "type": "number",
      "default": 0
    },
    "ga_users": {
      "type": "number",
      "default": 0
    },
    "health_score": {
      "type": "number",
      "default": 0,
      "description": "0-100 overall site health score"
    },
    "site_health": {
      "type": "string",
      "description": "JSON of site health check results"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "actions_taken": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "ai_insights": {
      "type": "string",
      "description": "AI-generated strategic insights and next actions"
    },
    "last_analyzed_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_action": {
      "type": "string",
      "description": "Next recommended action for this domain"
    },
    "pipeline_step": {
      "type": "string",
      "enum": [
        "register",
        "verify",
        "sitemap",
        "gsc",
        "ga",
        "competitors",
        "health",
        "complete"
      ],
      "default": "register"
    }
  },
  "required": [
    "domain"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": null,
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}