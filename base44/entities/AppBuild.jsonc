{
  "name": "AppBuild",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "template_id": {
      "type": "string",
      "description": "Reference to WebsiteTemplate"
    },
    "app_name": {
      "type": "string"
    },
    "app_slug": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "building",
        "built",
        "published",
        "failed"
      ],
      "default": "queued"
    },
    "platform": {
      "type": "string",
      "enum": [
        "pwa",
        "ios",
        "android",
        "both"
      ],
      "default": "pwa"
    },
    "manifest": {
      "type": "object",
      "description": "PWA manifest configuration",
      "properties": {
        "name": {
          "type": "string"
        },
        "short_name": {
          "type": "string"
        },
        "theme_color": {
          "type": "string"
        },
        "background_color": {
          "type": "string"
        },
        "display": {
          "type": "string",
          "default": "standalone"
        },
        "orientation": {
          "type": "string",
          "default": "portrait"
        }
      }
    },
    "nav_config": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "route": {
            "type": "string"
          }
        }
      },
      "description": "Bottom navigation bar configuration"
    },
    "icon_url": {
      "type": "string"
    },
    "splash_url": {
      "type": "string"
    },
    "build_log": {
      "type": "string"
    },
    "published_url": {
      "type": "string"
    },
    "gsc_indexing_status": {
      "type": "string",
      "description": "Google Search Console indexing state"
    },
    "gsc_impressions": {
      "type": "number",
      "default": 0,
      "description": "Search impressions (last 28 days, from GSC)"
    },
    "gsc_clicks": {
      "type": "number",
      "default": 0,
      "description": "Search clicks (last 28 days, from GSC)"
    },
    "gsc_avg_position": {
      "type": "number",
      "default": 0,
      "description": "Average search position (from GSC)"
    },
    "gsc_last_checked": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "app_name",
    "app_slug"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}