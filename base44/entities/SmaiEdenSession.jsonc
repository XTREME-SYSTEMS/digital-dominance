{
  "name": "SmaiEdenSession",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "welcome_shown": {
      "type": "boolean",
      "default": false
    },
    "approval_gate_explained": {
      "type": "boolean",
      "default": false
    },
    "steps_explained": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_key": {
            "type": "string"
          },
          "explained": {
            "type": "boolean",
            "default": false
          },
          "acknowledged_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "client_acknowledged": {
      "type": "boolean",
      "default": false
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time"
    },
    "chat_messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "eden",
              "client"
            ]
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "abandoned"
      ],
      "default": "active"
    }
  },
  "required": [
    "session_id",
    "client_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}