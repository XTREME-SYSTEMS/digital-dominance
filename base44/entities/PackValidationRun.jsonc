{
  "name": "PackValidationRun",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "validation_id": {
      "type": "string"
    },
    "receipt_id": {
      "type": "string"
    },
    "pack_id": {
      "type": "string"
    },
    "template_key": {
      "type": "string"
    },
    "target_url": {
      "type": "string"
    },
    "run_type": {
      "type": "string",
      "enum": [
        "visual",
        "operational",
        "full"
      ],
      "default": "full"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "pass",
        "fail",
        "blocked"
      ],
      "default": "queued"
    },
    "validator_name": {
      "type": "string"
    },
    "validator_version": {
      "type": "string"
    },
    "visual_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "operational_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "breakpoint_results": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "operational_checks": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "repair_attempt": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "max_repairs": {
      "type": "integer",
      "minimum": 0,
      "default": 3
    },
    "started_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "maxLength": 4000
    },
    "stage_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "One row per pipeline stage the audit exercised (profile, discovery, logos, build, photo posing)"
    },
    "workflow_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "points": {
            "type": "number"
          },
          "earned": {
            "type": "number"
          },
          "ratio": {
            "type": "number"
          },
          "critical": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "maxLength": 1000
          },
          "failed_pages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "default": [],
      "description": "The deterministic validator's scored criteria for this run"
    },
    "page_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "strengths": {
            "type": "string",
            "maxLength": 1000
          },
          "weaknesses": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "default": [],
      "description": "The QA reviewer's per-page scores for this run"
    },
    "validator_verdict": {
      "type": "string",
      "maxLength": 500,
      "description": "Deterministic validator's verdict line"
    },
    "qa_verdict": {
      "type": "string",
      "maxLength": 500,
      "description": "QA reviewer's verdict line"
    },
    "grade": {
      "type": "string",
      "maxLength": 4
    }
  },
  "required": [
    "validation_id",
    "receipt_id",
    "pack_id",
    "template_key",
    "run_type",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}