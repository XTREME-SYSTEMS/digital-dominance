{
  "name": "NearMeIntelligence",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "User ID who owns this record"
    },
    "geo_key": {
      "type": "string",
      "description": "Deterministic key: state:city or state:county or state"
    },
    "geo_type": {
      "type": "string",
      "enum": [
        "state",
        "city",
        "county"
      ],
      "default": "city"
    },
    "geo_name": {
      "type": "string",
      "description": "City, county, or state name"
    },
    "state_code": {
      "type": "string",
      "description": "2-letter state code (AL, NY, etc.)"
    },
    "county_name": {
      "type": "string"
    },
    "population": {
      "type": "number",
      "default": 0
    },
    "nearme_domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "registered": {
            "type": "boolean"
          },
          "service": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "nearyou_domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "registered": {
            "type": "boolean"
          },
          "service": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "available_domains": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Unregistered domains available for purchase"
    },
    "businesses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "rating": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "top_keywords": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string"
          },
          "volume": {
            "type": "number"
          },
          "difficulty": {
            "type": "number"
          },
          "intent": {
            "type": "string"
          },
          "opportunity": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "strategic_plan": {
      "type": "string",
      "maxLength": 30000,
      "description": "AI-generated strategic plan for this geography"
    },
    "proactive_insights": {
      "type": "string",
      "maxLength": 10000,
      "description": "Daily AI insights \u2014 what to do with this data"
    },
    "market_score": {
      "type": "number",
      "default": 0,
      "description": "0-100 opportunity score"
    },
    "last_scanned_at": {
      "type": "string",
      "format": "date-time"
    },
    "scan_status": {
      "type": "string",
      "enum": [
        "pending",
        "scanning",
        "complete",
        "failed"
      ],
      "default": "pending"
    },
    "drive_file_id": {
      "type": "string",
      "description": "Google Drive file ID for this geo's intelligence JSON"
    }
  },
  "required": [
    "geo_key",
    "geo_type",
    "geo_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": null,
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}