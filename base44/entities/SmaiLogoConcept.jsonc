{
  "name": "SmaiLogoConcept",
  "type": "object",
  "properties": {
    "concept_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "concept_number": {
      "type": "number",
      "description": "1-101"
    },
    "style": {
      "type": "string",
      "enum": [
        "wordmark",
        "lettermark",
        "emblem",
        "mascot",
        "abstract",
        "monogram",
        "combination"
      ]
    },
    "color_scheme": {
      "type": "string",
      "description": "Color scheme name (e.g. 'Electric Blue', 'Metallic Gold')"
    },
    "image_url": {
      "type": "string",
      "description": "Generated logo image URL"
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "AI description of the concept"
    },
    "rationale": {
      "type": "string",
      "maxLength": 1000,
      "description": "Why this concept fits the client's business"
    },
    "client_approved": {
      "type": "boolean",
      "default": false
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "batch_id": {
      "type": "string",
      "description": "Generation batch ID"
    }
  },
  "required": [
    "concept_id",
    "client_id",
    "concept_number",
    "style"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}