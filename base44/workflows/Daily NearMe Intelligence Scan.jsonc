{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_nearme_scan",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "seed": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "nearMeIntelligenceEngine",
            "args": {
              "action": "seed"
            }
          },
          "then": "batch_0",
          "x-base44": {
            "title": "Seed geographies",
            "description": "Ensure all 100 geographies exist"
          }
        }
      },
      {
        "batch_0": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "nearMeIntelligenceEngine",
            "args": {
              "action": "scanBatch",
              "batchIndex": 0,
              "totalBatches": 20,
              "batchSize": 5
            }
          },
          "then": "batch_1",
          "x-base44": {
            "title": "Scan batch 1/20"
          }
        }
      },
      {
        "batch_1": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "nearMeIntelligenceEngine",
            "args": {
              "action": "scanBatch",
              "batchIndex": 1,
              "totalBatches": 20,
              "batchSize": 5
