              "batchSize": 5
            }
          },
          "then": "batch_6",
          "x-base44": {
            "title": "Scan batch 6/20"
          }
        }
      },
      {
        "batch_6": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "nearMeIntelligenceEngine",
            "args": {
              "action": "scanBatch",
              "batchIndex": 6,
              "totalBatches": 20,
              "batchSize": 5
            }
          },
          "then": "batch_7",
          "x-base44": {
            "title": "Scan batch 7/20"
          }
        }
      },
      {
        "batch_7": {
          "call": "invoke_backend_function",
          "with": {
