              "limit": 20
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Refresh proactive insights",
            "description": "Regenerate AI insights for top 20 geographies"
          }
        }
      }
    ]
  },
  "description": "Daily autonomous scan: seeds geographies, checks nearme.com/nearyou.com domains, finds businesses, pulls keywords, generates strategic plans \u2014 all saved to Google Drive. Runs at 3 AM ET in 20 batches of 5 geographies each.",
  "name": "Daily NearMe Intelligence Scan",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
