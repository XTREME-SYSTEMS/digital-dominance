          "with": {
            "function_name": "nearMeIntelligenceEngine",
            "args": {
              "action": "scanBatch",
              "batchIndex": 3,
              "totalBatches": 20,
              "batchSize": 5
            }
          },
          "then": "batch_4",
          "x-base44": {
            "title": "Scan batch 4/20"
          }
        }
      },
      {
        "batch_4": {
