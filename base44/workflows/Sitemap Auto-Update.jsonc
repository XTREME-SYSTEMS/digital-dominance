{
  "name": "DDV3 Released Page Discovery Update",
  "description": "Only after a GeneratedPage becomes explicitly published, release-authorized, index-eligible, and sitemap-eligible, ping IndexNow and regenerate the sitemap.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "GeneratedPage",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"published\" && .trigger.data.release_authorized == true && .trigger.data.index_eligible == true && .trigger.data.sitemap_eligible == true }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sitemap_auto_update",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "ping_new_page": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pingIndexNow",
            "args": {
              "url": "https://epoxyquotenearme.com/${ .trigger.data.slug }"
            }
          },
          "then": "regenerate_sitemap",
          "x-base44": {
            "title": "Ping IndexNow",
            "description": "Notify IndexNow only after DDV3 release and index eligibility are explicit"
          }
        }
      },
      {
        "regenerate_sitemap": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateSitemap",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Regenerate sitemap",
            "description": "Rebuild dynamic sitemap with the new page"
          }
        }
      }
    ]
  }
}
