{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_site_validation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "validate_all": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "headlessSiteValidator",
            "args": {
              "mode": "validate_all_sites"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Validate All Sites",
            "description": "Headless browser checks every deployed site is live"
          }
        }
      }
    ]
  },
  "name": "Daily Site Validation",
  "description": "Runs headless validation on every deployed site daily to guarantee all sites are visible and live",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}