{
  "name": "GPT Template Sync",
  "description": "Read-only template inventory heartbeat. Paid template generation is paused pending scoped scheduler authorization and independent premium visual QA. No record writes.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": 6,
      "interval_unit": "hours",
      "interval_anchor": "2026-10-14T06:00:00Z",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "gpt_template_sync",
      "version": "1.1-read-only",
      "namespace": "base44"
    },
    "do": [
      {
        "generate_templates": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "gptTemplateIngestor",
            "args": {
              "action": "status"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Inspect GPT template inventory only",
            "description": "No InvokeLLM generation, spending, approval or writes"
          }
        }
      }
    ]
  }
}
