{
  "name": "SiteStatus Sheets Sync",
  "description": "Syncs SiteBank status changes to the master Google Sheet. Triggers on entity create and update.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "site_status_sheets_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_to_sheets": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "siteInventorySheetsSync",
            "args": {
              "site": "${ .trigger.data }",
              "event_type": "${ .trigger.event_type }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync to Google Sheets",
            "description": "Updates or appends the site row in the master Google Sheet"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "entity_name": "SiteBank",
      "events": [
        "create",
        "update"
      ]
    }
  }
}