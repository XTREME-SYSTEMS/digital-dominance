{
  "$schema": "https://railway.app/railway.schema.json",
  "deploy": {
    "name": "xtreme-workers",
    "service": {
      "image": "${{RAILWAY_DOCKERFILE_PATH}}/Dockerfile",
      "variables": {
        "NODE_ENV": "production",
        "CRON_KEY": "${{RAILWAY_CRON_KEY}}",
        "BASE44_APP_ID": "${{BASE44_APP_ID}}",
        "BASE44_API_KEY": "${{BASE44_SERVICE_ROLE_KEY}}",
        "VERCEL_AI_GATEWAY_API_KEY": "${{VERCEL_AI_GATEWAY_API_KEY}}",
        "CLOUD_BROWSER_ENGINE_URL": "${{CLOUD_BROWSER_ENGINE_URL}}",
        "ENGINE_API_KEY": "${{ENGINE_API_KEY}}",
        "XTREME_COMMUNICATION_API_KEY": "${{XTREME_COMMUNICATION_API_KEY}}",
        "TELNYX_API_KEY": "${{TELNYX_API_KEY}}",
        "SMAI_SUPABASE_URL": "${{SMAI_SUPABASE_URL}}",
        "SMAI_SUPABASE_ANON_KEY": "${{SMAI_SUPABASE_ANON_KEY}}",
        "SMAI_SUPABASE_SERVICE_ROLE_KEY": "${{SMAI_SUPABASE_SERVICE_ROLE_KEY}}"
      }
    },
    "cron": {
      "jobs": [
        {
          "name": "ddv3-heartbeat",
          "schedule": "*/5 * * * *",
          "command": "node worker.js ddv3_heartbeat",
          "description": "Single DDV3 authoritative scheduler tick: entity queue + queue/lease/learning reconciliation"
        }
      ]
    }
  }
}
